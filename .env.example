DATABASE_URL=postgres://postgres:123@localhost:5432/fix_gateway?sslmode=disable
# Read-only QUIK export (emitents / Orders / Securities). Used by GET /api/v1/admin/emitents/{symbol}/orders (`Quotes`).
QUIK_EXPORT_DATABASE_URL=postgres://postgres:123@192.168.0.89:5432/quik_export2?sslmode=disable
JWT_SECRET=change-me
API_TOKEN_PEPPER=change-me
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123
HTTP_ADDR=:8080
LB_STRATEGY=least_connections
CORS_ORIGINS=http://localhost:5173
# Override adapter host from DB (use 127.0.0.1 for local fixsimulator only). Leave empty for real ARQA hosts.
ADAPTER_HOST_OVERRIDE=
APP_ENV=development
TOKEN_PREFIX=sk_test_
REQUIRE_HTTPS=false
HMAC_REQUIRED=false
DEFAULT_RATE_LIMIT_RPS=100
DEFAULT_ORDER_RATE_LIMIT=20
AUTH_FAIL_MAX_PER_MINUTE=30
# Instrument dictionary is synced via FIX Security Definition (35=c/d), not via QUIK export DB.
# Background Request For Positions (35=AN). Set 0 to disable.
POSITION_SYNC_INTERVAL=30s
# Background Market Data Request (35=V) for «Текущие торги». Set 0 to disable.
MARKET_DATA_SYNC_INTERVAL=15s
# Comma-separated CIDRs of reverse proxies. X-Forwarded-For is trusted only from these peers.
TRUSTED_PROXIES=
# Do not write API_REQUEST logs for the admin UI (Vite :5173). Broker-app :5174 is still logged.
OBS_SKIP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OBS_FAST_MS=100
OBS_NORMAL_MS=500
OBS_SLOW_MS=2000
OBS_CHANNEL_SIZE=4096
# Store raw FIX payloads in debug events (never includes session passwords)
OBS_FIX_RAW_LOGS=false
OBS_API_RETENTION_DAYS=15
OBS_BUSINESS_RETENTION_DAYS=15
OBS_AUTH_RETENTION_DAYS=15
OBS_AUDIT_RETENTION_DAYS=15
OBS_DEBUG_RETENTION_DAYS=15
OBS_ERROR_RETENTION_DAYS=15
OBS_SYSTEM_RETENTION_DAYS=15
OBS_ALERT_WINDOW=1m
OBS_ERROR_WARN_PCT=5
OBS_ERROR_ERROR_PCT=10
OBS_ERROR_CRIT_PCT=20
OBS_LATENCY_WARN_MS=1000
OBS_LATENCY_ERROR_MS=3000
