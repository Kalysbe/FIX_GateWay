DATABASE_URL=postgres://postgres:123@localhost:5432/fix_gateway?sslmode=disable
# Read-only QUIK export (emitents / Orders / Securities). Used by GET /api/v1/admin/emitents/{symbol}/orders (`Quotes`).
# Use a dedicated SELECT-only role, never the QUIK superuser; keep the real password in .env only.
QUIK_EXPORT_DATABASE_URL=postgres://quik_reader:change-me@192.168.0.89:5432/quik_export2?sslmode=disable
# Internal QUIK Module API (http://192.168.0.89:5000/api/quotes). Changeable from admin UI.
QUIK_API_BASE_URL=http://192.168.0.89:5000
# Read-only trade reconciliation; enable only for an authorized QUIK source.
TRADE_RECONCILIATION_ENABLED=true
# FIX audit bytes retained per adapter on the persistent FIX state volume.
FIX_AUDIT_MAX_BYTES=4294967296
JWT_SECRET=change-me
API_TOKEN_PEPPER=change-me
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123
HTTP_ADDR=:8080
PROMETHEUS_URL=http://localhost:9090
API_READ_CONCURRENCY=32
API_TRADE_CONCURRENCY=16
API_REQUEST_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
RATE_LIMIT_MAX_STATES=100000
LB_STRATEGY=least_connections
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Override adapter host from DB (use 127.0.0.1 for local fixsimulator only). Leave empty for real ARQA hosts.
ADAPTER_HOST_OVERRIDE=
APP_ENV=development
REQUIRE_HTTPS=false
HMAC_REQUIRED=false
# Production-only overrides (ignored unless APP_ENV=production)
# ALLOW_INSECURE_HMAC=true
# ALLOW_INSECURE_HTTP=true
# ALLOW_INSECURE_DB=true
DEFAULT_RATE_LIMIT_RPS=100
DEFAULT_ORDER_RATE_LIMIT=20
AUTH_FAIL_MAX_PER_MINUTE=30
# Comma-separated CIDRs of reverse proxies. X-Forwarded-For / X-Forwarded-Proto
# are trusted only from these peers. Leave empty for direct (no reverse proxy) access.
TRUSTED_PROXIES=
# Instrument dictionary is synced via FIX Security Definition (35=c/d), not via QUIK export DB.
# Background Request For Positions (35=AN). Set 0 to disable.
POSITION_SYNC_INTERVAL=30s
# Background Market Data Request (35=V) for «Текущие торги». Set 0 to disable.
MARKET_DATA_SYNC_INTERVAL=15s
# QUIK class codes (FIX tag 100). Empty all-classes 35=V is rejected by ARQA.
MARKET_DATA_BOARDS=LISTEDSTOCKK,LIST_GBA
# Admin UI origins (Vite :5173); all /api/ requests are still logged.
OBS_SKIP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OBS_FAST_MS=100
OBS_NORMAL_MS=500
OBS_SLOW_MS=2000
OBS_CHANNEL_SIZE=4096
# Store raw FIX payloads in debug events (never includes session passwords)
OBS_FIX_RAW_LOGS=false
OBS_API_RETENTION_DAYS=15
OBS_BUSINESS_RETENTION_DAYS=15
OBS_AUTH_RETENTION_DAYS=15
OBS_AUDIT_RETENTION_DAYS=15
OBS_DEBUG_RETENTION_DAYS=15
OBS_ERROR_RETENTION_DAYS=15
OBS_SYSTEM_RETENTION_DAYS=15
OBS_ALERT_WINDOW=1m
OBS_ERROR_WARN_PCT=5
OBS_ERROR_ERROR_PCT=10
OBS_ERROR_CRIT_PCT=20
OBS_LATENCY_WARN_MS=1000
OBS_LATENCY_ERROR_MS=3000

# Native realtime gRPC: TLS mandatory, mTLS enabled by default.
# Generate DEVELOPMENT certificates first; see docs/realtime-grpc.md for production.
GRPC_ADDR=:8443
GRPC_TLS_CERT=certs/server.crt
GRPC_TLS_KEY=certs/server.key
GRPC_TLS_CA=certs/ca.crt
GRPC_MTLS_REQUIRED=true
GRPC_CLIENT_CERT=certs/bridge.crt
GRPC_CLIENT_KEY=certs/bridge.key
GRPC_TARGET=localhost:8443
GRPC_SERVER_NAME=localhost
