DATABASE_URL=postgres://postgres:123@localhost:5432/fix_gateway?sslmode=disable
JWT_SECRET=change-me
API_TOKEN_PEPPER=change-me
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123
HTTP_ADDR=:8080
LB_STRATEGY=least_connections
CORS_ORIGINS=http://localhost:5173
# Override adapter host from DB (use 127.0.0.1 for local fixsimulator only). Leave empty for real ARQA hosts.
ADAPTER_HOST_OVERRIDE=
APP_ENV=development
TOKEN_PREFIX=sk_test_
REQUIRE_HTTPS=false
HMAC_REQUIRED=false
DEFAULT_RATE_LIMIT_RPS=100
DEFAULT_ORDER_RATE_LIMIT=20
AUTH_FAIL_MAX_PER_MINUTE=30
# Instrument dictionary is synced via FIX Security Definition (35=c/d), not via QUIK export DB.
