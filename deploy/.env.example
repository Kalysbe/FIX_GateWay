JWT_SECRET=change-me-in-production
API_TOKEN_PEPPER=change-me-in-production
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123
LB_STRATEGY=least_connections
API_READ_CONCURRENCY=32
API_TRADE_CONCURRENCY=16
API_REQUEST_TIMEOUT=15s
RATE_LIMIT_MAX_STATES=100000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
# Test QUIK uses 192.168.0.89 from the adapter records; no host override is needed.
ADAPTER_HOST_OVERRIDE=
# Internal QUIK Module API origin (overridable from admin UI).
QUIK_API_BASE_URL=http://192.168.0.89:5000
# FIX audit bytes retained per adapter on the persistent FIX state volume.
FIX_AUDIT_MAX_BYTES=4294967296
# QUIK class codes for «Текущие торги» (FIX tag 100).
MARKET_DATA_BOARDS=LISTEDSTOCKK,LIST_GBA
# Only set when a reverse proxy sits in front of the gateway.
TRUSTED_PROXIES=

# Broker connections use VPN + TLS + Bearer tokens; no client certificates or HMAC by default.
GRPC_MTLS_REQUIRED=false
GRPC_CLIENT_CERT=
GRPC_CLIENT_KEY=
HMAC_REQUIRED=false
# Development Compose provisions TLS certificates; production uses operator server PKI. See ../docs/realtime-grpc.md.
PROMETHEUS_URL=http://prometheus:9090
